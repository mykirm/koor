# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# koor — local-only data + logs
# (gitignore does not support inline comments — keep patterns on their own lines)
# live demo log (may contain arbitrary user input)
/runs.jsonl
# raw mcPHASES (re-download from PhysioNet)
/data/raw/
# derived embedding cache — rebuild with scripts/build-embeddings.ts
/data/embeddings.*.json
*.local.json
# local README backup
*.bak

# Evaluation outputs ARE committed as evidence (NOT ignored):
#   data/eval-runs.jsonl, data/eval-scores.jsonl, data/scores.jsonl

PEER_REVIEW_AUDIT.md
